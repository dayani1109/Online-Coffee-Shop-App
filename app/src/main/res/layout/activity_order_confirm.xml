<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".orderConfirm">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout6"
        android:layout_width="424dp"
        android:layout_height="96dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="668dp"
        android:background="@color/soft_beige"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.666"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <ImageView
            android:id="@+id/OrderconfirmBackarrow"
            android:layout_width="35dp"
            android:layout_height="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.041"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.262"
            app:srcCompat="@drawable/backarrow" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/OrderplaceImageLogo"
        android:layout_width="177dp"
        android:layout_height="183dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.529"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/constraintLayout6"
        app:layout_constraintVertical_bias="0.095"
        app:srcCompat="@drawable/newlogo" />

    <TextView
        android:id="@+id/orderconfirmArrived"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arriving_time"
        android:textColor="#C26C20"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.543"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.471" />

    <TextView
        android:id="@+id/OrderplaceThanks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/thank_you_order"
        android:textColor="#C26C20"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.514"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.44" />

    <Button
        android:id="@+id/orderconfirmBtn2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#673209"
        android:text="Confirm Payment"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/constraintLayout6"
        app:layout_constraintVertical_bias="0.841" />

    <Button
        android:id="@+id/orderconfirmCancelBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#F57979"
        android:text="Cancel Order"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.931" />

    <LinearLayout
        android:id="@+id/linearLayout8"
        android:layout_width="338dp"
        android:layout_height="160dp"
        android:layout_marginStart="38dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="19dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.652">

        <TextView
            android:id="@+id/orderconfirmName"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Name"
            android:textSize="18sp"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="365dp" />

        <TextView
            android:id="@+id/orderconfirmAddress"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Address"
            android:textSize="18sp"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="405dp" />

        <TextView
            android:id="@+id/orderconfirmPhone"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Phone Number"
            android:textSize="18sp"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="445dp" />

        <TextView
            android:id="@+id/orderconfirmCard"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Card Number"
            android:textSize="18sp"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="485dp" />

        <TextView
            android:id="@+id/orderconfirmAmount"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Amount"
            android:textSize="18sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/OrderplaceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/order_confirmed"
        android:textAlignment="center"
        android:textColor="#693829"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.575"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.371" />

</androidx.constraintlayout.widget.ConstraintLayout>